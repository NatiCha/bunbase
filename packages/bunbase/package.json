{
  "name": "@naticha/bunbase",
  "version": "0.1.0",
  "description": "TypeScript-native Backend-as-a-Service built on Bun — REST API, auth, realtime, storage, and admin UI from a Drizzle schema",
  "author": "NatiCha",
  "license": "MIT",
  "keywords": [
    "bunbase",
    "baas",
    "backend",
    "bun",
    "drizzle",
    "rest-api",
    "typescript",
    "sqlite",
    "realtime"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/NatiCha/bunbase"
  },
  "homepage": "https://github.com/NatiCha/bunbase#readme",
  "type": "module",
  "bin": {
    "bunbase": "./src/cli/index.ts",
    "create-bunbase": "./src/cli/create.ts"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./src/index.ts"
    },
    "./client": {
      "types": "./dist/types/client.d.ts",
      "default": "./src/client.ts"
    },
    "./react": {
      "types": "./dist/types/react/index.d.ts",
      "default": "./src/react/index.tsx"
    },
    "./testing": {
      "types": "./dist/types/testing/index.d.ts",
      "default": "./src/testing/index.ts"
    }
  },
  "files": [
    "src",
    "dist/admin",
    "dist/types",
    "docs",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "bun run build.ts",
    "type": "tsc --noEmit",
    "test": "bun test src && bun test integration/database-regression.test.ts integration/security-regression.test.ts",
    "studio": "bunx drizzle-kit studio",
    "build:admin": "bun run build-admin.ts",
    "prepublishOnly": "bun run build && bun run type && bun run test",
    "build:types": "tsc --project tsconfig.emit.json",
    "test:databases": "bun test integration/databases.test.ts integration/database-regression.test.ts integration/security-regression.test.ts"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "drizzle-orm": "1.0.0-rc.4",
    "zod": "4.6.5"
  },
  "peerDependencies": {
    "@simplewebauthn/server": "^14.0.2",
    "@tanstack/react-query": ">=5",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "@simplewebauthn/server": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "@tanstack/react-query": {
      "optional": true
    }
  },
  "devDependencies": {
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-tooltip": "1.2.16",
    "@tanstack/react-query": "5.102.8",
    "@types/bun": "1.4.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "bun-plugin-tailwind": "0.1.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-kit": "1.0.0-rc.4",
    "lucide-react": "1.46.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "@simplewebauthn/server": "14.0.2"
  },
  "engines": {
    "bun": ">=1.4.2"
  }
}
